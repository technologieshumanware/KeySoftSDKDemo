<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/accessible_sample_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="48dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accessible_sample_title"
            android:textSize="24sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/accessible_sample_intro"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/name_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textSize="18sp" />

        <Button
            android:id="@+id/edit_name_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accessible_sample_edit_name" />

        <CheckBox
            android:id="@+id/notifications_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accessible_sample_notifications" />

        <Button
            android:id="@+id/terms_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/accessible_sample_terms" />

    </LinearLayout>

</ScrollView>
